{
  "realm": "inaiera",
  "enabled": true,
  "displayName": "InAiEra Platform",
  "sslRequired": "none",
  "registrationAllowed": false,
  "loginTheme": "inaiera",
  "clients": [
    {
      "clientId": "bff",
      "name": "Control Plane BFF",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "secret": "bff-secret",
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "redirectUris": [
        "http://localhost:4002/auth/callback"
      ],
      "webOrigins": [
        "http://localhost:3000"
      ],
      "attributes": {
        "post.logout.redirect.uris": "http://localhost:3000##http://localhost:3000/"
      },
      "protocolMappers": [
        {
          "name": "org_id",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "config": {
            "user.attribute": "org_id",
            "claim.name": "org_id",
            "jsonType.label": "String",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "pgclient",
      "name": "PostgreSQL OAuth Client",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": true,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": true,
      "attributes": {
        "oauth2.device.authorization.grant.enabled": "true"
      },
      "protocolMappers": [
        {
          "name": "email",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-property-mapper",
          "config": {
            "user.attribute": "email",
            "claim.name": "email",
            "jsonType.label": "String",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "inaiera-app",
      "name": "InAiEra Platform App",
      "description": "Confidential client used by inaiera-core to run the OIDC authorization-code (PKCE) login for the InAiEra React app.",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "secret": "inaiera-app-secret",
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "redirectUris": [
        "http://localhost:3009/api/auth/keycloak/callback"
      ],
      "webOrigins": [
        "http://localhost:5173",
        "http://localhost:5174",
        "http://localhost:5175",
        "http://localhost:3000"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://localhost:5173/*##http://localhost:5174/*##http://localhost:5175/*##http://localhost:3000/*"
      },
      "protocolMappers": [
        {
          "name": "org_id",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "config": {
            "user.attribute": "org_id",
            "claim.name": "org_id",
            "jsonType.label": "String",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "inaiera-admin",
      "name": "InAiEra Core \u2014 User Provisioning",
      "description": "Service account used by inaiera-core to mirror org user CRUD into Keycloak, so a user created by an org admin can actually sign in.",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "secret": "inaiera-admin-secret",
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true
    }
  ],
  "identityProviders": [
    {
      "alias": "acme",
      "displayName": "Acme Corp SSO",
      "providerId": "oidc",
      "enabled": true,
      "trustEmail": true,
      "storeToken": false,
      "firstBrokerLoginFlowAlias": "first broker login",
      "config": {
        "clientId": "inaiera-broker",
        "clientSecret": "acme-broker-secret",
        "authorizationUrl": "https://keycloak:8443/realms/acme/protocol/openid-connect/auth",
        "tokenUrl": "http://keycloak:8080/realms/acme/protocol/openid-connect/token",
        "userInfoUrl": "http://keycloak:8080/realms/acme/protocol/openid-connect/userinfo",
        "issuer": "https://keycloak:8443/realms/acme",
        "defaultScope": "openid profile email",
        "syncMode": "IMPORT"
      }
    }
  ],
  "identityProviderMappers": [
    {
      "name": "stamp-org-id",
      "identityProviderAlias": "acme",
      "identityProviderMapper": "hardcoded-attribute-idp-mapper",
      "config": {
        "attribute": "org_id",
        "attribute.value": "org_acme_001",
        "syncMode": "INHERIT"
      }
    }
  ],
  "users": [
    {
      "username": "service-account-inaiera-admin",
      "enabled": true,
      "serviceAccountClientId": "inaiera-admin",
      "clientRoles": {
        "realm-management": [
          "manage-users",
          "view-users",
          "query-users"
        ]
      }
    },
    {
